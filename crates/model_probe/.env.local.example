# 模型探活集成测试配置模板
#
# 复制本文件为 .env.local 并填入真实配置:
#   cp .env.local.example .env.local
#
# .env.local 不会被 git 提交(已在 .gitignore 中)。
# 运行集成测试:
#   cargo test -p model_probe --test integration -- --ignored --nocapture
#
# 集成测试默认 #[ignore],不影响 CI / 正常 cargo test。

# ═══ Anthropic 协议模型 ═══
# 智谱 GLM 示例:base_url = https://open.bigmodel.cn/api/anthropic
TEST_ANTHROPIC_BASE_URL=
TEST_ANTHROPIC_API_KEY=
TEST_ANTHROPIC_MODEL=

# ═══ OpenAI 协议模型 ═══
# DeepSeek 示例:base_url = https://api.deepseek.com/v1
#   wire_api 可选 "chat"(Chat Completions API)或 "response"(Responses API)
TEST_OPENAI_BASE_URL=
TEST_OPENAI_API_KEY=
TEST_OPENAI_MODEL=
TEST_OPENAI_WIRE_API=
