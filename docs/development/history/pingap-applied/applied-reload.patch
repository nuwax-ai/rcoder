+        );
+        let mut candidate = old;
+        candidate.locations.get_mut("second").unwrap().weight = Some(30);
+        let new_graph =
+            prepare(&candidate, old_graph.clone(), 2).await.unwrap();
+        assert_eq!(
+            new_graph.server_locations["app"].ordered.as_slice(),
+            &["second", "first"]
+        );
+        assert_eq!(
+            old_graph.server_locations["app"].ordered.as_slice(),
+            &["first", "second"]
+        );
+    }
+
+    #[tokio::test]
+    async fn concurrent_snapshot_readers_observe_one_complete_generation() {
+        use std::sync::atomic::{AtomicBool, Ordering};
+        let old = Arc::new(
+            prepare(
+                &marker_config("old"),
+                Arc::new(RuntimeGraph::default()),
+                1,
+            )
+            .await
+            .unwrap(),
+        );
+        let new = Arc::new(
+            prepare(&marker_config("new"), old.clone(), 2)
+                .await
+                .unwrap(),
+        );
+        let old_key = crate::plugin::get_hash_key(
+            &marker_config("old").plugins["rcoder:publication"],
+        );
+        let new_key = crate::plugin::get_hash_key(
+            &marker_config("new").plugins["rcoder:publication"],
+        );
+        let live = Arc::new(ArcSwap::from(old.clone()));
+        let stop = Arc::new(AtomicBool::new(false));
+        let readers: Vec<_> = (0..4)
+            .map(|_| {
+                let live = live.clone();
+                let stop = stop.clone();
+                let old_key = old_key.clone();
+                let new_key = new_key.clone();
+                std::thread::spawn(move || {
+                    let mut observations = 0;
+                    while !stop.load(Ordering::Acquire) || observations < 1000 {
+                        let graph = live.load_full();
+                        let (operation, key) = if graph.version == 1 {
+                            ("old", &old_key)
+                        } else {
+                            ("new", &new_key)
+                        };
+                        let location = &graph.locations["marker"];
+                        assert!(
+                            location
+                                .match_host_path(
+                                    "",
+                                    &format!("/_pub/{operation}")
+                                )
+                                .0
+                        );
+                        let resolved =
+                            location.plugins_for(graph.as_ref()).unwrap();
+                        assert_eq!(resolved[0].1.config_key().as_ref(), key);
+                        assert_eq!(
+                            graph.server_locations["app"].ordered.as_slice(),
+                            &["marker"]
+                        );
+                        observations += 1;
+                    }
+                })
+            })
+            .collect();
+        for i in 0..1000 {
+            live.store(if i % 2 == 0 { new.clone() } else { old.clone() });
+        }
+        stop.store(true, Ordering::Release);
+        for reader in readers {
+            reader.join().unwrap();
+        }
+    }
+}
