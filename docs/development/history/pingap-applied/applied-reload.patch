+/// The marker is a real mock response plugin; no additional config key is needed.
+fn operation_id(config: &PingapConfig) -> Option<String> {
+    config.plugins.get("rcoder:publication").and_then(|plugin| {
+        (plugin.get("category").and_then(|v| v.as_str()) == Some("mock"))
+            .then(|| {
+                plugin
+                    .get("data")
+                    .and_then(|v| v.as_str())
+                    .map(str::to_string)
+            })
+            .flatten()
+    })
+}
+
+#[derive(Clone, Debug, Serialize)]
+pub(crate) struct AppliedConfig {
+    pub attempt_id: u64,
+    pub operation_id: Option<String>,
+    pub config_hash: String,
+    pub config_digest: String,
+    pub applied_at_unix_ms: u64,
+}
+#[derive(Clone, Debug, Serialize)]
+pub(crate) struct ApplyFailure {
+    pub category: String,
+    pub message: String,
+}
+impl std::fmt::Display for ApplyFailure {
+    fn fmt(&self, formatter: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(formatter, "{}: {}", self.category, self.message)
+    }
+}
+impl std::error::Error for ApplyFailure {}
+impl ApplyFailure {
+    pub fn new(category: &str, error: impl std::fmt::Display) -> Self {
+        Self {
+            category: category.into(),
+            message: error.to_string(),
+        }
+    }
+}
+#[derive(Clone, Debug, Serialize)]
+pub(crate) struct ApplyAttempt {
+    pub attempt_id: u64,
+    pub operation_id: Option<String>,
+    pub config_hash: Option<String>,
+    pub config_digest: Option<String>,
+    pub state: String,
+    pub failure: Option<ApplyFailure>,
+}
+#[derive(Clone, Debug, Serialize)]
+pub(crate) struct ApplyStatus {
+    pub schema_version: u32,
+    pub process_id: u32,
+    pub process_instance_id: String,
+    pub applied: Option<AppliedConfig>,
+    pub last_attempt: Option<ApplyAttempt>,
+}
+impl Default for ApplyStatus {
+    fn default() -> Self {
+        Self {
+            schema_version: 1,
+            process_id: 0,
+            process_instance_id: String::new(),
+            applied: None,
+            last_attempt: None,
+        }
+    }
+}
+#[derive(Clone, Default)]
+struct RuntimeState {
+    graph: Arc<RuntimeGraph>,
+    status: ApplyStatus,
+}
+static STATE: LazyLock<ArcSwap<RuntimeState>> =
+    LazyLock::new(|| ArcSwap::from_pointee(RuntimeState::default()));
+struct ProcessIdentity {
+    pid: u32,
+    instance_id: String,
+}
+static PROCESS_IDENTITY: LazyLock<ArcSwap<ProcessIdentity>> =
+    LazyLock::new(|| {
+        ArcSwap::from_pointee(ProcessIdentity {
+            pid: std::process::id(),
+            instance_id: uuid::Uuid::now_v7().to_string(),
+        })
+    });
+
+fn process_identity() -> Arc<ProcessIdentity> {
+    let previous = PROCESS_IDENTITY.load_full();
+    let pid = std::process::id();
+    if previous.pid == pid {
+        return previous;
+    }
+    // A daemon fork can inherit a previously initialized identity. Publish one
+    // fresh UUID for the child; concurrent first readers share the CAS winner.
+    let fresh = Arc::new(ProcessIdentity {
+        pid,
+        instance_id: uuid::Uuid::now_v7().to_string(),
+    });
+    let replaced = PROCESS_IDENTITY.compare_and_swap(&previous, fresh.clone());
+    if Arc::ptr_eq(&previous, &replaced) {
+        fresh
+    } else {
+        PROCESS_IDENTITY.load_full()
+    }
+}
+/// Serializes polling and observers through preparation and publication.
+pub(crate) static APPLY_LOCK: tokio::sync::Mutex<()> =
+    tokio::sync::Mutex::const_new(());
+
+pub(crate) fn status() -> ApplyStatus {
+    let mut status = STATE.load().status.clone();
+    let identity = process_identity();
+    status.process_id = identity.pid;
+    // PID is read after daemon fork; the nonce also distinguishes PID reuse.
+    status.process_instance_id = identity.instance_id.clone();
+    status
+}
+pub(crate) fn graph() -> Arc<RuntimeGraph> {
+    STATE.load().graph.clone()
+}
+
+/// Startup-only replacement, before request services are running.
+pub(crate) fn initialize_part(update: impl FnOnce(&mut RuntimeGraph)) {
+    let mut state = (**STATE.load()).clone();
+    let mut graph = (*state.graph).clone();
+    update(&mut graph);
+    graph.version += 1;
+    state.graph = Arc::new(graph);
+    STATE.store(Arc::new(state));
+}
+
+pub(crate) fn begin_attempt(
+    config: Option<&PingapConfig>,
+) -> Result<u64, ApplyFailure> {
+    let mut state = (**STATE.load()).clone();
+    let previous = state
+        .status
+        .last_attempt
+        .as_ref()
+        .map_or(0, |attempt| attempt.attempt_id);
+    let attempt_id = previous.checked_add(1).ok_or_else(|| {
+        ApplyFailure::new("validation", "attempt identity exhausted")
+    })?;
+    let (operation_id, config_hash, config_digest) =
+        match config {
+            Some(config) => {
+                (
+                    operation_id(config),
+                    Some(config.hash().map_err(|error| {
+                        ApplyFailure::new("validation", error)
+                    })?),
+                    Some(config.digest().map_err(|error| {
+                        ApplyFailure::new("validation", error)
+                    })?),
+                )
+            },
+            None => (None, None, None),
+        };
+    state.status.last_attempt = Some(ApplyAttempt {
+        attempt_id,
+        operation_id,
+        config_hash,
+        config_digest,
+        state: "preparing".into(),
+        failure: None,
+    });
+    STATE.store(Arc::new(state));
+    Ok(attempt_id)
+}
+pub(crate) fn failed_attempt(
+    attempt_id: u64,
+    state_name: &str,
+    failure: ApplyFailure,
+) {
+    let mut state = (**STATE.load()).clone();
+    if let Some(attempt) = &mut state.status.last_attempt
+        && attempt.attempt_id == attempt_id
+    {
+        attempt.state = state_name.into();
+        attempt.failure = Some(failure);
+        STATE.store(Arc::new(state));
+    }
+}
+
+pub(crate) fn publish(
+    attempt_id: u64,
+    graph: impl Into<Arc<RuntimeGraph>>,
+) -> Result<(), ApplyFailure> {
+    let mut state = (**STATE.load()).clone();
+    let attempt = state.status.last_attempt.as_mut().ok_or_else(|| {
+        ApplyFailure::new("validation", "missing apply attempt")
+    })?;
+    if attempt.attempt_id != attempt_id {
+        return Err(ApplyFailure::new("validation", "obsolete apply attempt"));
+    }
+    let config_hash = attempt.config_hash.clone().ok_or_else(|| {
+        ApplyFailure::new("validation", "missing candidate hash")
+    })?;
+    let config_digest = attempt.config_digest.clone().ok_or_else(|| {
+        ApplyFailure::new("validation", "missing candidate digest")
+    })?;
+    attempt.state = "applied".into();
+    attempt.failure = None;
+    state.status.applied = Some(AppliedConfig {
+        attempt_id,
+        operation_id: attempt.operation_id.clone(),
+        config_hash,
+        config_digest,
+        applied_at_unix_ms: pingap_core::now_ms(),
+    });
+    state.graph = graph.into();
+    STATE.store(Arc::new(state));
+    Ok(())
+}
+
+pub(crate) fn record_bootstrap(
+    config: &PingapConfig,
+) -> Result<(), ApplyFailure> {
+    let attempt_id = begin_attempt(Some(config))?;
+    publish(attempt_id, graph())
+}
+
+pub(crate) fn check_supported(
+    current: &PingapConfig,
+    candidate: &PingapConfig,
+) -> Result<(), ApplyFailure> {
+    check_memory_cache_compatible(candidate)?;
+    let mut supported = current.clone();
+    supported.plugins = candidate.plugins.clone();
+    supported.locations = candidate.locations.clone();
+    supported.upstreams = candidate.upstreams.clone();
+    for (name, server) in &candidate.servers {
+        if let Some(existing) = supported.servers.get_mut(name) {
+            existing.locations = server.locations.clone();
+        }
+    }
+    if supported
+        .digest()
+        .map_err(|error| ApplyFailure::new("validation", error))?
+        != candidate
+            .digest()
+            .map_err(|error| ApplyFailure::new("validation", error))?
+    {
+        return Err(ApplyFailure::new(
+            "unsupported",
+            "hot reload supports plugins, locations, upstreams and existing server.locations only; other changes require restart",
+        ));
+    }
+    Ok(())
+}
+
+/// Memory cache resources survive removal from a request graph (standby), so
+/// compatibility must use the actual process registration rather than config names.
+fn check_memory_cache_compatible(
+    candidate: &PingapConfig,
+) -> Result<(), ApplyFailure> {
+    for (name, config) in &candidate.plugins {
+        if config.get("category").and_then(|value| value.as_str())
+            != Some("cache")
+        {
+            continue;
+        }
+        let directory = config
+            .get("directory")
+            .and_then(|value| value.as_str())
+            .unwrap_or_default();
+        if directory.is_empty() || directory.starts_with("memory://") {
+            pingap_cache::validate_memory_cache_backend(directory).map_err(
+                |error| {
+                    ApplyFailure::new(
+                        "unsupported",
+                        format!("cache plugin {name}: {error}"),
+                    )
+                },
+            )?;
+        }
+    }
+    Ok(())
+}
+
+pub(crate) fn prepare_locations(
+    config: &PingapConfig,
+    base: &RuntimeGraph,
+) -> Result<Locations, ApplyFailure> {
+    let mut locations = AHashMap::new();
+    for (name, conf) in &config.locations {
+        let location = match base.locations.get(name) {
+            Some(location) if location.key == conf.hash_key() => {
+                location.clone()
+            },
+            _ => Arc::new(
+                Location::new(name, conf)
+                    .map_err(|error| ApplyFailure::new("locations", error))?,
+            ),
+        };
+        locations.insert(name.clone(), location);
+    }
+    Ok(locations)
+}
+pub(crate) fn prepare_routes(
+    config: &PingapConfig,
+    locations: &Locations,
+) -> Result<ServerLocations, ApplyFailure> {
+    let mut routes = AHashMap::new();
+    for (name, server) in &config.servers {
+        let Some(ordered) = &server.locations else {
+            continue;
+        };
+        let mut ordered = ordered.clone();
+        for location_name in &ordered {
+            if !locations.contains_key(location_name) {
+                return Err(ApplyFailure::new(
+                    "server_locations",
+                    format!(
+                        "server {name} references missing location {location_name}"
+                    ),
+                ));
+            }
+        }
+        ordered.sort_by_key(|name| {
+            std::cmp::Reverse(
+                config
+                    .locations
+                    .get(name)
+                    .map_or(0, |conf| conf.get_weight()),
+            )
+        });
+        // Always rebuild from candidate Locations: host/weight changes affect the index
+        // even when the server's list of location names is unchanged.
+        routes.insert(
+            name.clone(),
+            Arc::new(ServerLocationRoute::build(ordered, |name| {
+                locations.get(name).cloned()
+            })),
+        );
+    }
+    Ok(routes)
+}
+
+pub(crate) async fn prepare(
+    config: &PingapConfig,
+    base: Arc<RuntimeGraph>,
+    version: u64,
+) -> Result<RuntimeGraph, ApplyFailure> {
+    config
+        .validate()
+        .map_err(|error| ApplyFailure::new("validation", error))?;
+    pingap_certificate::validate_servers_tls_for_backend(&config.servers)
+        .map_err(|error| ApplyFailure::new("validation", error))?;
+    let plugins =
+        crate::plugin::prepare_plugins(&config.plugins, &base.plugins)
+            .map_err(|error| ApplyFailure::new("plugins", error))?;
+    let locations = prepare_locations(config, &base)?;
+    let server_locations = prepare_routes(config, &locations)?;
+    validate_plugin_references(config, &plugins)?;
+    let (upstreams, changed) = pingap_upstream::new_ahash_upstreams(
+        &config.upstreams,
+        base,
+        crate::webhook::get_webhook_sender(),
+    )
+    .map_err(|error| ApplyFailure::new("upstreams", error))?;
+    for name in changed {
+        if let Some(upstream) = upstreams.get(&name) {
+            upstream.run_health_check().await.map_err(|error| {
+                ApplyFailure::new(
+                    "upstreams",
+                    format!("prepare {name}: {error}"),
+                )
+            })?;
+        }
+    }
+    Ok(RuntimeGraph {
+        plugins,
+        locations,
+        server_locations,
+        upstreams,
+        version,
+    })
+}
+
+pub(crate) fn validate_plugin_references(
+    config: &PingapConfig,
+    plugins: &Plugins,
+) -> Result<(), ApplyFailure> {
+    for (name, location) in &config.locations {
+        for plugin_name in location.plugins.iter().flatten() {
+            if !plugins.contains_key(plugin_name) {
+                return Err(ApplyFailure::new(
+                    "plugins",
+                    format!(
+                        "location {name} references missing plugin {plugin_name}"
+                    ),
+                ));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Live providers are used by admin metrics and health tasks; request processing
+/// captures a concrete immutable RuntimeGraph instead.
+pub(crate) struct LiveProvider;
+impl PluginProvider for LiveProvider {
+    fn get(&self, name: &str) -> Option<Arc<dyn Plugin>> {
+        graph().plugins.get(name).cloned()
+    }
+    fn version(&self) -> u64 {
+        graph().version
+    }
+}
+impl LocationProvider for LiveProvider {
+    fn get(&self, name: &str) -> Option<Arc<Location>> {
+        graph().locations.get(name).cloned()
+    }
+    fn stats(&self) -> HashMap<String, LocationStats> {
+        LocationProvider::stats(graph().as_ref())
+    }
+}
+impl UpstreamProvider for LiveProvider {
+    fn get(&self, name: &str) -> Option<Arc<Upstream>> {
+        graph().upstreams.get(name).cloned()
+    }
+    fn list(&self) -> Vec<(String, Arc<Upstream>)> {
+        UpstreamProvider::list(graph().as_ref())
+    }
+}
+impl ServerLocationsProvider for LiveProvider {
+    fn get(&self, name: &str) -> Option<Arc<ServerLocationRoute>> {
+        graph().server_locations.get(name).cloned()
+    }
+    fn snapshot(&self) -> Option<Arc<RequestProviders>> {
+        let graph = graph();
+        Some(Arc::new(RequestProviders {
+            server_locations: graph.clone(),
+            locations: graph.clone(),
+            upstreams: graph.clone(),
+            plugins: graph,
+        }))
+    }
+}
