@@ -0,0 +1,23 @@
+use pingap_config::PingapConfig;
+
+#[test]
+fn complete_digest_canonical_json_golden() {
+    let config =
+        PingapConfig::new(include_bytes!("fixtures/applied-config.toml"), true)
+            .unwrap();
+    let mut value = serde_json::to_value(&config).unwrap();
+    value.sort_all_objects();
+    let canonical = serde_json::to_vec(&value).unwrap();
+    assert_eq!(canonical, include_bytes!("fixtures/applied-config.json"));
+    assert_eq!(
+        config.digest().unwrap(),
+        include_str!("fixtures/applied-config.sha256").trim()
+    );
+    let mut changed = config.clone();
+    changed
+        .plugins
+        .get_mut("rcoder:publication")
+        .unwrap()
+        .insert("data".into(), toml::Value::String("new-operation".into()));
+    assert_ne!(config.digest().unwrap(), changed.digest().unwrap());
+}
