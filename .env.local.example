# rcoder e2e 集成测试配置模板
#
# 复制为仓库根 .env.local（已被 gitignore，不会提交）后按需填写：
#   cp .env.local.example .env.local
# 读取优先级：环境变量 > .env.local > 默认值。
# 三个测试目标共用：Rust（tests-e2e，make test-e2e-compose / test-e2e-k8s）
# 与 Python（tests/sse_e2e、tests/userapp_compose_regression.py）。

# ── compose 环境（Rust/Python 通用）──────────────────────────────────────────
# rcoder 服务地址（默认 http://127.0.0.1:8090；K8s 远程时填 NodePort 入口）
RCODER_URL=http://127.0.0.1:8090

# ── LLM 模型配置（chat 场景必需）────────────────────────────────────────────
# API key（绝不提交；测试报告已脱敏，api_key 不落盘）
LLM_API_KEY=
# openai 协议兼容的模型代理 base_url
LLM_BASE_URL=
# 默认模型 id
LLM_MODEL=
# 切模型场景的目标模型（未配置时 model_switch 场景 skip）
LLM_MODEL_PRO=
# anthropic 协议（claude-code-acp-ts 后端）的模型代理 base_url
LLM_BASE_URL_ANTHROPIC=

# ── K8s 专项（k8s_lb；lb 场景默认 ignore，--ignored 显式跑）──────────────────
# ⚠️ 只配个人开发测试 K8s（20 / 229 单节点）；19 机有生产环境，未经明确
#    指示不得对其跑测试。
# ssh 免密目标（远程 kubectl 解析与测试资源清理）
TEST_K8S_SSH=
# 测试命名空间（默认 nuwax-k8s-test）
TEST_K8S_NS=nuwax-k8s-test
# 节点入口 IP 列表（逗号分隔；单节点只填一个，入口轮换退化为同入口，
# SSE 语义断言仍有效；多入口负载均衡语义需多节点集群）
LB_ENTRY_HOSTS=
# NodePort 端口（默认 30295）
LB_NODEPORT=30295
