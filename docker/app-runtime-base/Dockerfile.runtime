# ============================================================================
# app-runtime: 统一多语言应用运行时（Rust + Node + Python + Java + Go）
# ============================================================================
# 合并原 Dockerfile.{node,python,java,go,rust} 为单镜像 —— 用户部署任意语言应用，
# workspace 多语言项目（前端+后端不同语言）可同容器运行，不再按语言拆镜像。
#
# 基础设施 + 语言运行时本体（node/python/java/go/deno + Rust）已在 app-runtime-base（Dockerfile）。
# 本层只装"高频变化"内容：npm 全局工具 + app-cli / file-server-proxy
# （rcoder 源码产物，末层 COPY）——分层原则：越稳定越靠下（base），越易变越靠上（本文件末层）。
# （与 build-agent-docker 65a1cb8/878c3f6 分层同步。）
# ENTRYPOINT=start-app.sh（base 继承），app-cli 从 release.lock.toml 编排服务。
ARG BASE_IMAGE=app-runtime-base:latest
ARG DOCKER_MIRROR

# === app-cli builder（从当前 rcoder 源编译 app-cli + file-server-proxy；自 base Dockerfile 迁入）===
# rcoder 源码产物随源频繁变化：编译放本文件（runtime 层），base 不含任何 rcoder 源码依赖，
# app-cli 变更不再引发 base 层 digest 变化（父链失效 → runtime 全量重建）。
# 产物 COPY 刻意落在本文件最末层，原因同上。
# rcoder 源码经 docker/build-app-runtime.py 以命名构建上下文 rcoder= 注入（本仓源，
# 非 build-agent-docker 的 vendored 快照）。
FROM ${DOCKER_MIRROR}rust:trixie AS app-cli-builder
WORKDIR /build
# builder 阶段先换国内 apt 源(默认 deb.debian.org 从国内拉易 stall),与 base 主 stage 的换源对齐
RUN curl -sSL https://linuxmirrors.cn/main.sh | bash -s -- \
        --source mirrors.aliyun.com --protocol https --use-intranet-source false \
        --install-epel false --backup false --upgrade-software false --clean-cache true --ignore-backup-tips && \
    apt-get update && apt-get install -y --no-install-recommends cmake libclang-dev protobuf-compiler && rm -rf /var/lib/apt/lists/*
COPY --from=rcoder / .
ARG RCODER_SOURCE_COMMIT
ARG RCODER_SOURCE_BRANCH
# 删 rust-toolchain.toml（若存在）：仓库当前未 pin toolchain，但防御性移除可避免
# 未来重新引入 pin 时触发 rustup 下载指定版本（~200MB,走 static.rust-lang.org 官方,国内极慢），
# base image rust:trixie 自带的最新 stable 向下兼容。
RUN rm -f rust-toolchain.toml
# 配置 cargo 源(国内 rsproxy 加速)。文件在 .cargo/config.toml,查阅/修改方便。
COPY .cargo/config.toml /usr/local/cargo/config.toml
RUN cd crates/app-cli && cargo build --release
# 容器内文件服务单件（RBD 卷形态·容器中心化，file-server-proxy 0.2.0 起）：file-server-proxy
# default feature 自带 file-server lib 进程内直连（60000 AllRust，无独立 8086 进程/端口）。
# -p 显式选 package：裸 --bin 的解析范围是 workspace default-members（不含
# file-server-proxy），会报 no bin target ... in default-run packages。
RUN cargo build --release -p file-server-proxy

FROM ${BASE_IMAGE}
ARG PINGAP_VERSION
ARG PINGAP_COMMIT
ARG NODE_RUNTIME_VERSION
RUN test "$(pingap -V)" = "pingap ${PINGAP_VERSION}" && \
    test "$(pingap --version)" = "pingap ${PINGAP_VERSION} (${PINGAP_COMMIT}, tls=openssl)" && \
    test "$(node --version)" = "v${NODE_RUNTIME_VERSION}"

# ── npm 全局工具（高频变化 → 留本镜像，不进 base）──────────────────────────────
# node/npm 本体与语言运行时（python/java/go/deno）已在 base（Dockerfile）；
# npm fetch-retries=5 已随 base 的 node 安装写入全局 npmrc。
# pnpm 保持字面 major pin。（本地 dev 镜像按构建时 latest 解析；生产用
# resolve-then-pin 版本注入，见 build-agent-docker 16-app-runtime.mk。）
RUN npm install -g pm2 typescript ts-node pnpm@10

# ── dbx MCP server（dbx 官方 MCP：与 agent-runner 镜像同款安装）─────────────────
# DBX_WEB_URL 指容器内 supervisor 恒起的 dbx-web :4224（WebBackend → dbx-web HTTP →
# PG socket 免密），spawn 即零配置。仅 dbx-mcp-server 读此变量，dbx-web 本体不读，无冲突。
# 官方源：平台二进制 optionalDependencies（@dbx-app/mcp-linux-*）npmmirror 同步有延迟
# 会 404 静默跳过致二进制缺失（.npmrc 默认国内源必须显式覆盖）；--verify-platform 构建期自检。
RUN npm i -g @dbx-app/mcp-server@latest --registry https://registry.npmjs.org && \
    dbx-mcp-server --verify-platform
ENV DBX_WEB_URL=http://localhost:4224

# 入口继承 base：ENTRYPOINT=start-app.sh，用户服务命令来自 release.lock.toml。

# ── app-cli + file-server-proxy（rcoder 源码产物，app-cli-builder stage 编译）──────
# 刻意放在文件最末层：rcoder 源频繁变化时仅重建 builder + 本 COPY 层，
# 前面的 npm 工具层与 base 的全部大层（JDK/Go/Python/Node）均缓存命中（分层迁移的原因）。
# app-cli：UserApp 容器编排器（替代 start.sh；supervisor 托管，按 release.lock.toml 编排服务）。
# file-server-proxy：容器内文件服务（supervisor 托管，见 app-runtime.supervisor.conf）——rcoder
# 转发层 (x-app-stage: prod) 的上游。0.2.0 起 file-server 以 lib 直连集成，无独立 8086 进程；
# USERAPP_SINGLE_APP_ID=APP_ID 单 app 模式由 rcoder 创建容器时注入，本地直跑无 APP_ID →
# 空值=多 app 开发语义，无害。
COPY --from=app-cli-builder /build/crates/app-cli/target/release/app-cli /usr/local/bin/app-cli
COPY --from=app-cli-builder /build/target/release/file-server-proxy /usr/local/bin/file-server-proxy
