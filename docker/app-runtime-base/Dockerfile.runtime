# ============================================================================
# app-runtime: 统一多语言应用运行时（Rust + Node + Python + Java + Go）
# ============================================================================
# 合并原 Dockerfile.{node,python,java,go,rust} 为单镜像 —— 用户部署任意语言应用，
# workspace 多语言项目（前端+后端不同语言）可同容器运行，不再按语言拆镜像。
#
# 基础设施 + Rust（rust:bookworm）继承自 app-runtime-base（Dockerfile）。本层补 Node/Python/Java/Go。
# ENTRYPOINT=start-app.sh（base 继承），UserApp command 覆盖 CMD 作 args 传入。
#
# ⚠️ Python 版本契约：与 agent-runner builder 镜像统一 rust:bookworm（原生 3.11
# 双侧同 ABI）——builder pip 装的 wheel 在本运行时原生可载（cp311 ↔ cp311）。
# ⚠️ 镜像体积：Rust(~1.5G,来自 base)+Go+JDK+Python+Node，约 4-5GB —— 全语言自由的代价。
ARG BASE_IMAGE=app-runtime-base:latest
FROM ${BASE_IMAGE}

# ── Node.js / TypeScript（+ pnpm 锁大版本 10 + Deno）──────────────────────────
ENV NODE_VERSION=24
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pm2 typescript ts-node pnpm@10 \
    && rm -rf /var/lib/apt/lists/*

# Deno（JS/TS 运行时，最新版；DENO_INSTALL=/usr/local → /usr/local/bin/deno，在默认 PATH）
RUN curl -fsSL https://deno.land/install.sh | DENO_INSTALL=/usr/local sh

# ── Python（Debian bookworm 自带 3.11）+ uv ───────────────────────────────────
# uv（Astral 极速 Python 包管理器，最新版）经 pip 装到 /usr/local/bin，在默认 PATH。
RUN apt-get update && apt-get install -y \
       python3 \
       python3-pip \
       python3-venv \
       python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && pip3 install --no-cache-dir --break-system-packages pip setuptools wheel virtualenv uv

# ── Java (Temurin 25 LTS + Maven + Gradle + Arthas) ─────────────────────────
# bookworm 官方仓库无 openjdk-25（trixie 才有）——经 Adoptium apt repo 装
# Temurin 25（与 agent-runner builder 的 JDK 段同源同版，builder 编 target=25
# 与运行时 25 对齐；块照搬自 rcoder-agent-runner/Dockerfile.base 已验证实现）。
RUN apt-get update && \
    apt-get install -y wget apt-transport-https gpg ca-certificates maven gradle && \
    wget -qO - https://packages.adoptium.net/artifactory/api/gpg/key/public \
        | gpg --dearmor -o /usr/share/keyrings/adoptium.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/adoptium.gpg] https://packages.adoptium.net/artifactory/deb $(awk -F= '/VERSION_CODENAME/{print $2}' /etc/os-release) main" \
        > /etc/apt/sources.list.d/adoptium.list && \
    apt-get update && \
    apt-get install -y temurin-25-jdk && \
    ARCH=$(dpkg --print-architecture) && \
    ln -sf /usr/lib/jvm/temurin-25-jdk-${ARCH} /usr/lib/jvm/temurin-25-jdk-current && \
    java -version && javac -version && \
    rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://arthas.aliyun.com/arthas-boot.jar -o /usr/local/bin/arthas-boot.jar \
    && printf '#!/bin/bash\njava -jar /usr/local/bin/arthas-boot.jar "$@"\n' > /usr/local/bin/arthas \
    && chmod +x /usr/local/bin/arthas
ENV JAVA_HOME=/usr/lib/jvm/temurin-25-jdk-current
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ── Go ────────────────────────────────────────────────────────────────────────
ENV GO_VERSION=1.26.4
RUN ARCH=$(dpkg --print-architecture) \
    && wget -q https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz -O /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV GOPATH=/root/go

# Rust 已在 app-runtime-base（rust:bookworm）层提供，cargo 在 PATH（base ENV 透传）。
# 聚合 PATH：Go + Go bin（node 在 /usr/bin、python/java 在默认 PATH，无需追加）
ENV PATH="/usr/local/go/bin:${GOPATH}/bin:${PATH}"

# 入口继承 base：ENTRYPOINT=start-app.sh，CMD 被 UserApp command 覆盖
