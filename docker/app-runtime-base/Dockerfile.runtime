# ============================================================================
# app-runtime: 统一多语言应用运行时（Rust + Node + Python + Java + Go）
# ============================================================================
# 合并原 Dockerfile.{node,python,java,go,rust} 为单镜像 —— 用户部署任意语言应用，
# workspace 多语言项目（前端+后端不同语言）可同容器运行，不再按语言拆镜像。
#
# 基础设施 + Rust（rust:trixie，随 tag 浮动）继承自 app-runtime-base（Dockerfile）。本层补 Node/Python/Java/Go。
# ENTRYPOINT=start-app.sh（base 继承），UserApp command 覆盖 CMD 作 args 传入。
#
# ⚠️ Python 版本契约：与 agent-runner builder 镜像统一 rust:trixie（原生 3.13
# 双侧同 ABI）——builder pip 装的 wheel 在本运行时原生可载（cp313 ↔ cp313）。
# ⚠️ 镜像体积：Rust(~1.5G,来自 base)+Go+JDK+Python+Node，约 4-5GB —— 全语言自由的代价。
ARG BASE_IMAGE=app-runtime-base:latest
FROM ${BASE_IMAGE}

# ── Node.js / TypeScript（+ pnpm 锁大版本 10 + Deno）──────────────────────────
ENV NODE_VERSION=24
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_VERSION}.x | bash - \
    && apt-get install -y nodejs \
    && npm install -g pm2 typescript ts-node pnpm@10 \
    && rm -rf /var/lib/apt/lists/*

# ── dbx MCP server（dbx 官方 MCP；与 build-agent-docker 正式镜像同款，防本地/生产工具面漂移）──
# DBX_WEB_URL 指容器内 dbx-web :4224（WebBackend → PG socket 免密），spawn 即零配置。
# 官方源：平台二进制 optionalDependencies（@dbx-app/mcp-linux-*）npmmirror 同步延迟
# 404 静默跳过致二进制缺失；--verify-platform 构建期自检。
RUN npm i -g @dbx-app/mcp-server@latest --registry https://registry.npmjs.org && \
    dbx-mcp-server --verify-platform
ENV DBX_WEB_URL=http://localhost:4224

# Deno（JS/TS 运行时；deno.land 安装脚本在部分构建网络不可达 exit 35——改
# registry 镜像拉取固定版本，与 rcoder-agent-runner base 的 Deno 同源同版）
COPY --from=denoland/deno:bin-2.5.6 /deno /usr/local/bin/deno
RUN chmod +x /usr/local/bin/deno && rm -rf /root/.cache/deno

# ── Python（Debian trixie 自带 3.13）+ uv ────────────────────────────────────
# uv（Astral 极速 Python 包管理器，最新版）经 pip 装到 /usr/local/bin，在默认 PATH。
RUN apt-get update && apt-get install -y \
       python3 \
       python3-pip \
       python3-venv \
       python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && pip3 install --no-cache-dir --break-system-packages --ignore-installed pip setuptools wheel virtualenv uv

# ── Java (openjdk-25 + Maven + Gradle + Arthas) ─────────────────────────────
# trixie 官方仓库原生提供 openjdk-25（bookworm 时代缺位曾走 Adoptium Temurin 源；
# 与 agent-runner builder 的 JDK 段同源同版，builder 编 target=25 与运行时 25 对齐）。
RUN apt-get update && \
    apt-get install -y maven gradle openjdk-25-jdk && \
    ARCH=$(dpkg --print-architecture) && \
    ln -sf /usr/lib/jvm/java-25-openjdk-${ARCH} /usr/lib/jvm/java-25-openjdk-current && \
    java -version && javac -version && \
    rm -rf /var/lib/apt/lists/* \
    && curl -fsSL https://arthas.aliyun.com/arthas-boot.jar -o /usr/local/bin/arthas-boot.jar \
    && printf '#!/bin/bash\njava -jar /usr/local/bin/arthas-boot.jar "$@"\n' > /usr/local/bin/arthas \
    && chmod +x /usr/local/bin/arthas
ENV JAVA_HOME=/usr/lib/jvm/java-25-openjdk-current
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ── Go ────────────────────────────────────────────────────────────────────────
ENV GO_VERSION=1.26.4
RUN ARCH=$(dpkg --print-architecture) \
    && wget -q https://go.dev/dl/go${GO_VERSION}.linux-${ARCH}.tar.gz -O /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV GOPATH=/root/go

# Rust 已在 app-runtime-base（rust:trixie）层提供，cargo 在 PATH（base ENV 透传）。
# 聚合 PATH：Go + Go bin（node 在 /usr/bin、python/java 在默认 PATH，无需追加）
ENV PATH="/usr/local/go/bin:${GOPATH}/bin:${PATH}"

# 入口继承 base：ENTRYPOINT=start-app.sh，CMD 被 UserApp command 覆盖
