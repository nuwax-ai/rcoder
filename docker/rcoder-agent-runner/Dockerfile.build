# 独立的构建 Dockerfile - 仅用于构建 agent_runner 二进制
# rust:bookworm 跟随最新 stable，同时保留 Debian 12 的 GLIBC 基线。

FROM rust:bookworm AS builder

# 设置工作目录
WORKDIR /build

# 安装系统依赖；工具链由基础镜像提供。
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    cmake \
    pkg-config \
    protobuf-compiler \
    libprotobuf-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

RUN cargo --version && rustc --version

# Rust cargo 国内镜像配置（与 rcoder-master/Dockerfile.base 同款 heredoc 内联；
# rust 镜像的 CARGO_HOME 为 /usr/local/cargo，配置必须写到实际读取位置）。
COPY <<'EOF_CARGO' /usr/local/cargo/config.toml
[source.crates-io]
replace-with = 'rsproxy-sparse'

[source.rsproxy]
registry = "https://rsproxy.cn/crates.io-index"

[source.rsproxy-sparse]
registry = "sparse+https://rsproxy.cn/index/"
EOF_CARGO

# 🎯 代码哈希标记：只有当 CRATES_HASH 变化时，以下步骤才会重新执行
# 这样可以缓存上面的系统依赖和 Rust 安装
ARG CRATES_HASH=unknown
RUN echo "Code hash: ${CRATES_HASH}"

# 复制 Cargo.toml 和 Cargo.lock
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# workspace 成员（tests-e2e 被 Cargo.toml members 引用，缺失则 manifest 加载失败）
COPY tests-e2e ./tests-e2e
# utoipa-swagger-ui build.rs 的 swagger-ui 资源：宿主预下载 vendor（构建容器直连
# GitHub DNS 抖动失败率极高）；file:// URL 为该 build.rs 官方支持
# ⚠️ 升级 utoipa-swagger-ui 时须同步更新此 zip 版本（当前对应 9.0.2 → v5.17.14）
COPY docker/rcoder-agent-runner/deps/swagger-ui-v5.17.14.zip /build/deps/swagger-ui-v5.17.14.zip
ENV SWAGGER_UI_DOWNLOAD_URL=file:///build/deps/swagger-ui-v5.17.14.zip

# 🔧 支持 CARGO_FLAGS 参数，允许外部传递 feature flags
ARG CARGO_FLAGS
# dial9 feature 在列时由 make/docker.mk 传入 --cfg tokio_unstable（全量 task 覆盖）
ARG RUSTFLAGS=""
ENV RUSTFLAGS="${RUSTFLAGS}"
RUN echo "🔧 Cargo flags: ${CARGO_FLAGS}" && \
    cargo build --release --bin agent_runner ${CARGO_FLAGS}

# 构建 app-cli（UserApp 容器编排器；对齐生产 build_config L70-77）：
# app-cli 被 workspace exclude（独立 Cargo.lock），不能从根 --bin 构建，
# 必须 cd 进 crate 目录单独编；输出在 crate 自己的 target 下。
# dev/start（manifest 引擎 spawn app-cli）的前置。
RUN cd crates/app-cli && cargo build --release

# Export only the artifacts consumed by make; compiler layers remain build cache.
# docker create needs a command, but the extraction container is never started.
FROM scratch AS artifacts
COPY --from=builder /build/target/release/agent_runner /build/target/release/agent_runner
COPY --from=builder /build/crates/app-cli/target/release/app-cli /build/crates/app-cli/target/release/app-cli
CMD ["/build/target/release/agent_runner"]
