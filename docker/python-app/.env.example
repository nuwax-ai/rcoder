# Python + PostgreSQL + Node + etcd 应用容器配置

# PostgreSQL 配置
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# Python 应用配置
FLASK_ENV=production
FLASK_APP=app.py
PYTHONUNBUFFERED=1
PYTHONPATH=/app/src

# Node.js 应用配置
NODE_ENV=production
PORT=3000

# etcd 配置
ETCD_NAME=etcd-node-1
ETCD_ENDPOINTS=http://localhost:2379
ETCD_DATA_DIR=/app/data/etcd

# 应用环境
APP_ENV=production

# 数据库连接
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# 日志级别
LOG_LEVEL=info

# Gunicorn 配置
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
