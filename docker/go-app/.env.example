# Go + PostgreSQL + Node + etcd 应用容器配置

# PostgreSQL 配置
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# Go 应用配置
APP_ENV=production
PORT=8080
GIN_MODE=release

# Node.js 应用配置
NODE_ENV=production
NODE_PORT=3000

# etcd 配置
ETCD_NAME=etcd-node-1
ETCD_ENDPOINTS=http://localhost:2379
ETCD_DATA_DIR=/app/data/etcd

# 数据库连接
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
