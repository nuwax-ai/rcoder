# TypeScript + PostgreSQL + Node + etcd 应用容器配置

# PostgreSQL 配置
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# Node.js/TypeScript 应用配置
NODE_ENV=production
PORT=3000
TS_NODE_PROJECT=/app/tsconfig.json

# etcd 配置
ETCD_NAME=etcd-node-1
ETCD_ENDPOINTS=http://localhost:2379
ETCD_DATA_DIR=/app/data/etcd

# 应用环境
APP_ENV=production

# 数据库连接
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
DB_HOST=localhost
DB_PORT=5432
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}
DB_NAME=${POSTGRES_DB}

# 日志级别
LOG_LEVEL=info

# Express 配置
EXPRESS_TRUST_PROXY=1
