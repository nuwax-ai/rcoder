# Append to repo .env.local (ignored). SSH keys/config provide authentication.
REMOTE_K8S_SSH=your-linux-alias
REMOTE_K8S_DIR=/home/your-user/rcoder-remote-k8s
REMOTE_K8S_CONTEXT=default
REMOTE_K8S_NAMESPACE=rcoder-e2e-soddy
REMOTE_K8S_MUTAGEN=mutagen
# Dedicated image repository prefix, reachable from builder AND every Kubernetes node.
REMOTE_K8S_REGISTRY=registry.example.com/rcoder-e2e
REMOTE_K8S_REGISTRY_HTTP=false
# Defaults to <namespace>-; prevents collisions inside a shared registry namespace.
REMOTE_K8S_IMAGE_PREFIX=rcoder-e2e-soddy-
# Existing complete runtime images; build resolves them to digests before use.
REMOTE_K8S_RCODER_BASE=registry.example.com/runtime/rcoder-k8s:version
REMOTE_K8S_COMPUTER_BASE=registry.example.com/runtime/rcoder-computer-agent-runner:version
REMOTE_K8S_RUNTIME_BASE=registry.example.com/runtime/app-runtime:version
REMOTE_K8S_RUST_IMAGE=rust:1.95-trixie
REMOTE_K8S_JOBS=4
REMOTE_K8S_CPUS=4
REMOTE_K8S_MEMORY=16g
REMOTE_K8S_BUILD_TIMEOUT=3600
REMOTE_K8S_TIMEOUT=180
# Direct RCoder Service NodePort. Gateway gets its own controller-assigned NodePort.
REMOTE_K8S_NODEPORT=31290
REMOTE_K8S_URL=http://your-linux-host:31290
REMOTE_K8S_ENTRY_HOSTS=your-linux-host
REMOTE_K8S_STORAGE_CLASS=cephfs
REMOTE_K8S_PG_STORAGE_CLASS=ceph-rbd
REMOTE_K8S_USERAPP_STORAGE_CLASS=ceph-rbd
REMOTE_K8S_POSTGRES_IMAGE=postgres:16-alpine
REMOTE_K8S_CEPH_DRIVER=rook-ceph.cephfs.csi.ceph.com
REMOTE_K8S_CEPH_CLUSTER=rook-ceph
REMOTE_K8S_CEPH_FS=myfs
REMOTE_K8S_CEPH_SECRET=rook-csi-cephfs-node
REMOTE_K8S_CEPH_SECRET_NS=rook-ceph
# chat/all additionally require existing LLM_API_KEY, LLM_MODEL and LLM_BASE_URL.
# Optional comma-separated BuildKit Docker Hub mirror hosts (no scheme).
REMOTE_K8S_DOCKER_MIRRORS=
# Private output images: import ONLY this registry auth from remote ~/.docker/config.json.
# none (public images) or docker (inline auth; external credential helpers are not read).
REMOTE_K8S_REGISTRY_AUTH=none
# Optional: reuse existing base blobs server-side before push. Requires HTTPS,
# inline Docker auth, same registry, and cross-repository mount support.
REMOTE_K8S_MOUNT_BASE_LAYERS=false
# Debian package mirror base URL (must provide /debian and /debian-security).
REMOTE_K8S_APT_MIRROR=http://deb.debian.org
# Optional alternate crates.io source; Cargo.lock stays unchanged.
REMOTE_K8S_CARGO_MIRROR=
# Optional: real Helm chart for `make remote-k8s-tenant-isolation`.
# Runs against the owned test namespace only, after main Pod label rollout.
# REMOTE_K8S_ISOLATION_CHART=/path/to/build-agent-docker/k8s/helm/nuwax-platform
